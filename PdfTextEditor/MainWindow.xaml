<Window x:Class="PdfTextEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF 편집기" Height="900" Width="1280"
        Background="#1E1E1E"
        Icon="Assets/app.ico"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
  <Window.Resources>
    <!-- Acrobat 스타일 토글 버튼 -->
    <Style x:Key="ToolBtn" TargetType="RadioButton">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Margin="4,1">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ico" Text="{TemplateBinding Content}" FontSize="11"
                           Foreground="#D0D0D0" TextAlignment="Center" TextWrapping="Wrap"
                           Width="44"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3D3D3D"/>
                <Setter TargetName="ico" Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="ico" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#353535"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TopBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E8E8E8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#404040"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#666"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PropLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#BBB"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ═══════ 상단 메뉴 (어두운) ═══════ -->
    <Menu DockPanel.Dock="Top" Background="#2C2C2C" Foreground="#EEE">
      <Menu.Resources>
        <Style TargetType="MenuItem">
          <Setter Property="Foreground" Value="#EEE"/>
          <Setter Property="Background" Value="#2C2C2C"/>
        </Style>
      </Menu.Resources>
      <MenuItem x:Name="MenuFile" Header="파일(_F)">
        <MenuItem Header="새로 만들기…" InputGestureText="Ctrl+N" Click="New_Click"/>
        <MenuItem Header="열기" InputGestureText="Ctrl+O" Click="Open_Click"/>
        <Separator/>
        <MenuItem Header="저장" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="다른 이름으로 저장…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="인쇄…" InputGestureText="Ctrl+P" Click="Print_Click"/>
        <Separator/>
        <MenuItem Header="Word로 내보내기…" Click="ExportWord_Click"/>
        <MenuItem Header="페이지 추출하여 저장…" Click="Extract_Click"/>
        <MenuItem Header="페이지별로 분할 저장…" Click="Split_Click"/>
        <Separator/>
        <MenuItem Header="종료" InputGestureText="Alt+F4" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuEdit" Header="편집(_E)">
        <MenuItem Header="되돌리기" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="찾기…" InputGestureText="Ctrl+F" Click="Find_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuPage" Header="페이지(_P)">
        <MenuItem Header="시계 방향 회전" Click="RotateCw_Click"/>
        <MenuItem Header="반시계 방향 회전" Click="RotateCcw_Click"/>
        <Separator/>
        <MenuItem Header="현재 페이지 삭제" Click="DeletePage_Click"/>
        <MenuItem Header="앞으로 이동" Click="MoveUp_Click"/>
        <MenuItem Header="뒤로 이동" Click="MoveDown_Click"/>
        <Separator/>
        <MenuItem Header="빈 페이지 삽입 (현재 뒤)" Click="InsertBlank_Click"/>
        <MenuItem Header="다른 PDF 삽입/병합 (현재 뒤)…" Click="InsertPdf_Click"/>
        <MenuItem Header="페이지 자르기…" Click="Crop_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuDoc" Header="문서(_D)">
        <MenuItem Header="워터마크…" Click="Watermark_Click"/>
        <MenuItem Header="머리글/바닥글/쪽 번호…" Click="HeaderFooter_Click"/>
        <MenuItem Header="배경색 (선택한 색)" Click="Background_Click"/>
        <Separator/>
        <MenuItem Header="인증서로 전자서명…" Click="Sign_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuFont" Header="글꼴(_T)">
        <MenuItem Header="글꼴 관리…" Click="FontManager_Click"/>
        <Separator/>
        <MenuItem Header="폰트 목록 갱신" Click="RefreshFonts_Click"/>
        <MenuItem Header="오프라인용 기본 폰트 받기" Click="Prefetch_Click"/>
      </MenuItem>
      <MenuItem x:Name="MenuLang" Header="언어(_L)">
        <MenuItem x:Name="LangKo" Header="한국어" Click="Lang_Click" Tag="ko" IsCheckable="True"/>
        <MenuItem x:Name="LangEn" Header="English" Click="Lang_Click" Tag="en" IsCheckable="True"/>
        <MenuItem x:Name="LangEs" Header="Español" Click="Lang_Click" Tag="es" IsCheckable="True"/>
        <MenuItem x:Name="LangFr" Header="Français" Click="Lang_Click" Tag="fr" IsCheckable="True"/>
      </MenuItem>
      <MenuItem x:Name="MenuHelp" Header="도움말(_H)">
        <MenuItem x:Name="MiTutorial" Header="시작 가이드 (튜토리얼)" Click="Tutorial_Click"/>
        <Separator/>
        <MenuItem x:Name="MiRegister" Header="Windows 기본 프로그램으로 등록…" Click="RegisterDefault_Click"/>
        <MenuItem x:Name="MiUnregister" Header="기본 프로그램 등록 해제" Click="UnregisterDefault_Click"/>
        <MenuItem x:Name="MiDefaults" Header="Windows 기본 앱 설정 열기" Click="OpenDefaultApps_Click"/>
        <Separator/>
        <MenuItem x:Name="MiAbout" Header="정보" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <!-- ═══════ 상단 빠른 도구 막대 ═══════ -->
    <Border DockPanel.Dock="Top" Background="#323232" Padding="6,4">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Style="{StaticResource TopBtn}" x:Name="BtnNew" Content="새로 만들기" Click="New_Click"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnOpen" Content="열기" Click="Open_Click"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnSave" Content="저장" Click="Save_Click"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnSaveAs" Content="다른 이름" Click="SaveAs_Click"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnPrint" Content="인쇄" Click="Print_Click"/>
          <Button x:Name="UndoBtn" Style="{StaticResource TopBtn}" x:Name="BtnUndo" Content="되돌리기" Click="Undo_Click" IsEnabled="False"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnFind" Content="찾기" Click="Find_Click"/>
          <Border Width="1" Background="#555" Margin="8,4"/>
          <Button x:Name="PrevBtn" Style="{StaticResource TopBtn}" Content="◀" Click="Prev_Click" IsEnabled="False"/>
          <TextBlock x:Name="PageText" Text="- / -" Foreground="#CCC" VerticalAlignment="Center" Margin="6,0" MinWidth="56" TextAlignment="Center"/>
          <Button x:Name="NextBtn" Style="{StaticResource TopBtn}" Content="▶" Click="Next_Click" IsEnabled="False"/>
          <Border Width="1" Background="#555" Margin="8,4"/>
          <Button Style="{StaticResource TopBtn}" Content="－" Click="ZoomOut_Click" ToolTip="축소"/>
          <TextBlock x:Name="ZoomText" Text="150%" Foreground="#CCC" VerticalAlignment="Center" Margin="4,0" MinWidth="40" TextAlignment="Center"/>
          <Button Style="{StaticResource TopBtn}" Content="＋" Click="ZoomIn_Click" ToolTip="확대"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnFitW" Content="너비" Click="ZoomFitWidth_Click" ToolTip="페이지 너비에 맞추기"/>
          <Button Style="{StaticResource TopBtn}" x:Name="BtnFitPage" Content="전체" Click="ZoomFitPage_Click" ToolTip="페이지 전체에 맞추기"/>
        </StackPanel>
        <Button Style="{StaticResource TopBtn}" x:Name="BtnFontMgr" Content="글꼴 관리" Click="FontManager_Click"
                DockPanel.Dock="Right" HorizontalAlignment="Right"
                Background="#E3482B" Foreground="White" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>

    <!-- ═══════ 속성 막대 (색/글꼴/크기) ═══════ -->
    <Border DockPanel.Dock="Top" Background="#3A3A3A" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource PropLabel}" Text="색상"/>
        <ComboBox x:Name="ColorBox" Width="72" Height="26" VerticalContentAlignment="Center"/>
        <TextBlock Style="{StaticResource PropLabel}" Text="선 굵기" Margin="14,0,4,0"/>
        <TextBox x:Name="WidthBox" Text="2" Width="36" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        <TextBlock Style="{StaticResource PropLabel}" Text="크기" Margin="14,0,4,0"/>
        <TextBox x:Name="SizeBox" Text="14" Width="36" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        <TextBlock Style="{StaticResource PropLabel}" Text="투명도%" Margin="14,0,4,0"/>
        <TextBox x:Name="OpacityBox" Text="100" Width="40" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        <TextBlock Style="{StaticResource PropLabel}" Text="글꼴" Margin="14,0,4,0"/>
        <ComboBox x:Name="FontBox" Width="200" Height="26" VerticalContentAlignment="Center"
                  IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                  ToolTip="클릭하여 검색 · 화살표로 목록"
                  SelectionChanged="FontBox_SelectionChanged"
                  KeyUp="FontBox_KeyUp"
                  DropDownOpened="FontBox_DropDownOpened"/>
        <CheckBox x:Name="BoldChk" Content="굵게" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#DDD"/>
        <CheckBox x:Name="ItalicChk" Content="기울임" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#DDD"/>
        <CheckBox x:Name="FillChk" Content="도형 채우기" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#DDD"/>
      </StackPanel>
    </Border>

    <!-- ═══════ 상태 표시줄 ═══════ -->
    <Border DockPanel.Dock="Bottom" Background="#2C2C2C" Padding="12,5">
      <TextBlock x:Name="StatusText" Text="PDF 파일을 여세요." Foreground="#AAA" FontSize="12"/>
    </Border>

    <!-- ═══════ 본문: 왼쪽 도구 + 문서 영역 ═══════ -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 왼쪽 도구 패널 (Acrobat 스타일) -->
      <Border Grid.Column="0" Background="#252525" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,6,0,6">
            <TextBlock Text="편집" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,2"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Edit" IsChecked="True" Content="텍스트&#x0a;수정" Checked="Tool_Checked" ToolTip="텍스트 수정"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Delete" Content="텍스트&#x0a;삭제" Checked="Tool_Checked" ToolTip="텍스트 삭제"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="TextBox" Content="텍스트&#x0a;상자" Checked="Tool_Checked" ToolTip="텍스트 상자 추가"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Image" Content="이미지&#x0a;삽입" Checked="Tool_Checked" ToolTip="이미지 삽입"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="ImageEdit" Content="이미지&#x0a;편집" Checked="Tool_Checked" ToolTip="기존 이미지 크기 조절·삭제"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Table" Content="표" Checked="Tool_Checked" ToolTip="표 추가"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Chart" Content="그래프" Checked="Tool_Checked" ToolTip="막대 그래프 추가"/>

            <Border Height="1" Background="#3A3A3A" Margin="10,8"/>
            <TextBlock Text="그리기" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Rect" Content="사각형" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Ellipse" Content="타원" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Line" Content="선" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Arrow" Content="화살표" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Pen" Content="펜/서명" Checked="Tool_Checked"/>

            <Border Height="1" Background="#3A3A3A" Margin="10,8"/>
            <TextBlock Text="주석" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Highlight" Content="형광펜" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Underline" Content="밑줄" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Strike" Content="취소선" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Note" Content="메모" Checked="Tool_Checked"/>
            <RadioButton Style="{StaticResource ToolBtn}" GroupName="tool" Tag="Link" Content="링크" Checked="Tool_Checked"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 문서 캔버스 -->
      <Border Grid.Column="1" Background="#4A4A4A">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#4A4A4A">
          <Grid x:Name="PageHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24"
                Background="White">
            <Border Background="White" Effect="{x:Null}">
              <Grid>
                <Image x:Name="PageImage" Stretch="Fill"/>
                <Canvas x:Name="Overlay" Background="Transparent"
                        MouseLeftButtonDown="Overlay_MouseDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseUp"/>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
